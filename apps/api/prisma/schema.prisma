generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── Enums ─────────

enum Role {
  OWNER
  SUPERVISOR
  WAITER
  CASHIER
  PREPARATOR
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum PhoneVerifiedMethod {
  /// Le restaurant a rappelé le numéro et la personne a répondu
  CALLBACK
  /// Réservé : code SMS / WhatsApp après immatriculation
  OTP
}

enum RecoveryStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum EmailCodePurpose {
  /// Inscription par email : le compte n'existe qu'après saisie du code
  REGISTER
  /// Rattacher un email à un compte existant
  ADD_EMAIL
  /// Réinitialisation du mot de passe ou du PIN
  RESET
}

enum CredentialType {
  PIN
  PASSWORD
}

/// Espace d'authentification : le personnel (back-office) ou les clients (vitrine)
enum AuthAudience {
  STAFF
  CUSTOMER
}

enum OrderStatus {
  DRAFT
  PENDING_PREP
  IN_PREP
  PARTIALLY_READY
  READY
  PARTIALLY_SERVED
  SERVED
  CANCELLED
}

enum OrderChannel {
  DINE_IN
  PICKUP
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ───────── Identité & multi-tenant ─────────

model User {
  id                    String               @id @default(uuid(7))
  name                  String
  phone                 String?              @unique
  phoneVerifiedAt       DateTime?
  phoneVerifiedMethod   PhoneVerifiedMethod?
  email                 String?              @unique
  emailVerifiedAt       DateTime?
  googleSub             String?              @unique
  locale                String               @default("fr")
  /// Compte en mode restreint (après récupération par questions) jusqu'à cette date
  restrictedUntil       DateTime?
  /// Restaurant qui a créé ce compte employé : lui seul peut réinitialiser son PIN
  managedByRestaurantId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  managedByRestaurant Restaurant?       @relation("ManagedUsers", fields: [managedByRestaurantId], references: [id], onDelete: SetNull)
  memberships         Membership[]
  orders              Order[]           @relation("CustomerOrders")
  reservations        Reservation[]
  credentials         Credential[]
  recoveryProfile     RecoveryProfile?
  recoveryCodes       RecoveryCode[]
  refreshTokens       RefreshToken[]
  recoveryRequests    RecoveryRequest[]
}

model Restaurant {
  id           String   @id @default(uuid(7))
  slug         String   @unique
  name         String
  description  String?
  city         String
  address      String?
  phone        String?
  latitude     Float?
  longitude    Float?
  timezone     String   @default("Africa/Douala")
  currency     String   @default("XAF")
  openingHours Json?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  Membership[]
  managedUsers User[]        @relation("ManagedUsers")
  tables       DiningTable[]
  categories   Category[]
  products     Product[]
  orders       Order[]
  reservations Reservation[]
  syncActions  SyncAction[]
}

model Membership {
  id           String           @id @default(uuid(7))
  userId       String
  restaurantId String
  role         Role
  status       MembershipStatus @default(PENDING)
  approvedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
  @@index([restaurantId])
}

// ───────── Salle & catalogue ─────────

model DiningTable {
  id           String   @id @default(uuid(7))
  restaurantId String
  label        String
  seats        Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  reservations Reservation[]

  @@unique([restaurantId, label])
}

model Category {
  id           String   @id @default(uuid(7))
  restaurantId String
  name         String
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([restaurantId, name])
}

model Product {
  id           String   @id @default(uuid(7))
  restaurantId String
  categoryId   String
  name         String
  description  String?
  /// Prix en XAF (entier, sans décimales)
  price        Int
  unit         String   @default("portion")
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
  items      OrderItem[]

  @@index([restaurantId, categoryId])
}

// ───────── Commandes ─────────

model Order {
  /// UUIDv7 généré côté client (création hors ligne possible)
  id            String       @id @default(uuid(7))
  restaurantId  String
  /// Numéro lisible attribué par le serveur à la synchronisation (null tant que non synchronisé)
  number        Int?
  channel       OrderChannel @default(DINE_IN)
  status        OrderStatus  @default(DRAFT)
  tableId       String?
  customerId    String?
  customerName  String?
  customerPhone String?
  isPaid        Boolean      @default(false)
  pickupAt      DateTime?
  expectedAt    DateTime?
  waiterId      String?
  cashierId     String?
  preparatorId  String?
  supervisorId  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable?   @relation(fields: [tableId], references: [id])
  customer   User?          @relation("CustomerOrders", fields: [customerId], references: [id])
  items      OrderItem[]
  comments   OrderComment[]
  payments   Payment[]

  @@unique([restaurantId, number])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id        String   @id @default(uuid(7))
  orderId   String
  productId String
  /// Copie du nom et du prix au moment de la commande
  name      String
  unitPrice Int
  qty       Int
  note      String?
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderComment {
  id        String   @id @default(uuid(7))
  orderId   String
  authorId  String?
  role      Role?
  message   String
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id             String        @id @default(uuid(7))
  orderId        String
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  amount         Int
  /// Fournisseur (MTN MoMo, Orange Money, ...) : renseigné quand les paiements en ligne seront actifs
  provider       String?
  providerRef    String?
  idempotencyKey String        @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ───────── Réservations ─────────

model Reservation {
  id            String            @id @default(uuid(7))
  restaurantId  String
  tableId       String?
  customerId    String?
  customerName  String
  customerPhone String?
  partySize     Int
  startsAt      DateTime
  durationMin   Int               @default(90)
  status        ReservationStatus @default(PENDING)
  note          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable? @relation(fields: [tableId], references: [id])
  customer   User?        @relation(fields: [customerId], references: [id])

  @@index([restaurantId, startsAt])
}

// ───────── Synchronisation hors ligne ─────────

/// Journal des actions client rejouées ; l'id (UUID client) garantit l'idempotence.
model SyncAction {
  id           String    @id
  restaurantId String
  deviceId     String
  userId       String?
  type         String
  payload      Json
  /// Date de l'action côté appareil
  clientAt     DateTime
  receivedAt   DateTime  @default(now())
  appliedAt    DateTime?
  error        String?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, receivedAt])
}

// ───────── Authentification ─────────

model Credential {
  id         String         @id @default(uuid(7))
  userId     String
  type       CredentialType
  /// Argon2id du secret, avec pepper serveur
  hash       String
  /// Doit être changé à la prochaine connexion (PIN temporaire donné par un gérant)
  mustChange Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

/// Données de récupération : empreintes uniquement, jamais en clair.
model RecoveryProfile {
  userId        String   @id
  birthDateHash String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers RecoveryAnswer[]
}

model RecoveryAnswer {
  id         String @id @default(uuid(7))
  userId     String
  /// RECOVERY_QUESTIONS de @resto/shared
  question   String
  answerHash String

  profile RecoveryProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, question])
}

/// Code de secours remis une seule fois à l'inscription.
model RecoveryCode {
  id        String    @id @default(uuid(7))
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Jeton de rafraîchissement, stocké haché (SHA-256), avec rotation par « famille ».
model RefreshToken {
  id        String       @id @default(uuid(7))
  userId    String
  audience  AuthAudience
  familyId  String
  tokenHash String       @unique
  deviceId  String?
  userAgent String?
  createdAt DateTime     @default(now())
  expiresAt DateTime
  /// Renseigné quand le jeton a été échangé contre un nouveau (rejeu = famille révoquée)
  usedAt    DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Tentatives d'authentification (échecs et succès) pour le ralentissement progressif.
model AuthAttempt {
  id        String   @id @default(uuid(7))
  /// ex. `login:phone:+237677123456`, `login:ip:1.2.3.4`
  key       String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid(7))
  userId       String?
  restaurantId String?
  action       String
  meta         Json?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([restaurantId, createdAt])
}

/// Récupération différée (comptes ayant un rôle dans un restaurant) : le nouveau PIN est
/// choisi tout de suite mais n'entre en vigueur qu'à `availableAt`, sauf annulation.
model RecoveryRequest {
  id          String         @id @default(uuid(7))
  userId      String
  newPinHash  String
  status      RecoveryStatus @default(PENDING)
  availableAt DateTime
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?
  /// Qui a annulé : le titulaire (« Ce n'est pas moi »), un gérant, ou sa propre connexion
  cancelledBy String?
  ip          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// Code à 6 chiffres envoyé par email. Pour REGISTER, porte aussi les données d'inscription
/// (le compte n'est créé qu'à la vérification, donc aucun compte orphelin ni email « squatté »).
model EmailCode {
  id           String           @id @default(uuid(7))
  purpose      EmailCodePurpose
  email        String
  userId       String?
  codeHash     String
  attempts     Int              @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime         @default(now())
  audience     AuthAudience?
  name         String?
  passwordHash String?

  @@index([email, purpose])
}
