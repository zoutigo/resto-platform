{
  "name": "@resto/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --exec \"node --env-file=../../.env\"",
    "start": "node --env-file=../../.env dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@resto/shared": "*",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.18",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^2.1.9"
  }
}
