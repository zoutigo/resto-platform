DATABASE_URL=postgresql://resto:resto@localhost:5433/resto
REDIS_URL=redis://localhost:6380
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Authentification : secrets à remplacer en production (au moins 32 caractères)
AUTH_JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
AUTH_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# Origines autorisées pour les cookies de session (séparées par des virgules)
WEB_ORIGINS=http://localhost:3000,http://localhost:3001
# Email (codes de vérification et de réinitialisation). Sans SMTP_URL : console en dev, désactivé en production.
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.com:465
# MAIL_FROM="Resto <no-reply@exemple.com>"
# Connexion Google : identifiant client OAuth (type « Application Web » et/ou mobile), sinon 503 sur /auth/*/google
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
